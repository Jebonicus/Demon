# Copy to .env and fill in. Never commit .env.

# --- API keys -------------------------------------------------------------
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# The voice you design at elevenlabs.io (Voices > Voice Design), copy its ID.
ELEVENLABS_VOICE_ID=

# --- Models / voice ------------------------------------------------------
LLM_MODEL=claude-haiku-5-5
# eleven_flash_v2_5  - lowest latency (~75 ms), reads the text plainly
# eleven_v4_turbo    - ~100 ms, more expressive, acts out [laughs], [whispers] etc.
#                      (only VOICE_STABILITY applies; lower = more dramatic)
# Don't use plain eleven_v4 or eleven_v3: they're built for voiceovers, not live chat.
ELEVENLABS_MODEL=eleven_flash_v2_5
STT_LANGUAGE=en-GB
VOICE_STABILITY=0.45
VOICE_SIMILARITY=0.8
VOICE_STYLE=0.35

# --- Voice FX: off | lite | demon ----------------------------------------
FX_PRESET=demon
FX_SEMITONES=-4
FX_HIGHPASS_HZ=180

# --- Audio ----------------------------------------------------------------
# 16000 keeps CPU low on the Pi 3A+ and matches the XVF3800's native rate.
SAMPLE_RATE=16000
# Leave blank to use the system default (on the Pi, setup makes the XVF3800 the default).
# On a laptop, run `python bot.py --list-devices` to find indexes.
AUDIO_IN_DEVICE=
AUDIO_OUT_DEVICE=
# Raise VAD_MIN_VOLUME if wind/traffic triggers it; lower if quiet kids get ignored.
VAD_CONFIDENCE=0.7
VAD_STOP_SECS=0.2
VAD_MIN_VOLUME=0.6
# Seconds of silence before the visitor's turn counts as finished.
TURN_STOP_SECS=0.6
# Speaker buffer in 10 ms chunks. Raise if the voice crackles; lower for snappier interruptions.
AUDIO_OUT_CHUNKS=10
# Ignore the mic while the witch is talking (stops her own voice interrupting her).
# Set false to let visitors talk over her; needs good echo cancellation.
MUTE_WHILE_SPEAKING=true

# --- Camera trigger (MQTT) ------------------------------------------------
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
PRESENCE_TOPIC=halloween/presence
# Same units as the publisher's "nearest" field. JebCam's tracker uses pixels
# from its reference point, so tune this by watching the annotated video.
ENGAGE_DIST=250
LEAVE_SECS=8
MAX_SESSION_SECS=180

LOG_LEVEL=INFO
